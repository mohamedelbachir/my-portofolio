---
import { Image } from "astro:assets";
import MyPhoto from "@/assets/images/me.jpeg";
import { Icon } from "astro-icon/components";
import Brand from "./Brand.astro";
---

<section id="about" class="screen-wrapper my-14">
  <div class="w-full flex gap-10 max-sm:flex-col">
    <div
      aria-hidden="true"
      class="grow relative profile after:bg-dot-blue-500 max-sm:h-[300px]"
      data-aos="fade-up"
    >
      <Image
        class="w-full bg-gray-500 shadow-lg h-full object-cover object-top max-h-[400px]"
        width={500}
        height={500}
        widths={[400, 768]}
        sizes="(max-width: 768px) 100vw, 432px"
        src={MyPhoto}
        alt={"Mohamed el bachir profile"}
      />
    </div>
    <div class="w-2/3 max-sm:w-full" data-aos="fade-up" data-aos-delay="250">
      <div class="btn-shape bg-primary py-2 px-5 w-fit text-lg text-white mb-4">
        About
      </div>
      <h3
        class="font-heading leading-none font-semibold text-2xl text-primary py-4"
      >
        Why hire me for your next project ?
      </h3>
      <p class="text-justify dark:text-white text-lg">
        As a Master's student in Computer Science specializing in software
        systems and distributed environments, I offer a strong academic
        background and a deep passion for programming. I am eager to apply my
        technical skills to drive innovation and contribute meaningfully to
        challenging projects
      </p>
      <h3
        class="font-heading leading-none font-semibold text-xl text-primary py-4"
      >
        My social :
      </h3>
      <div class="flex gap-3 mt-2">
        <a
          href="http://github.com/mohamedelbachir"
          target="_blank"
          rel="noopener noreferrer"><Brand name="github" pClass="size-10" /></a
        >
        <a
          href="https://www.linkedin.com/in/mohamed-el-bachir"
          target="_blank"
          rel="noopener noreferrer"
          ><Brand name="linkedin" pClass="size-10" /></a
        >
        <a href="https://wa.me/+237698340664"
          ><Brand name="whatsapp" pClass="size-10" /></a
        >
      </div>

      <button class="mt-5 btn-no-shape flex gap-3" data-download-cv>
        <Icon name="tabler:download" class={"size-5"} />
        Download my CV
      </button>
    </div>
  </div>
</section>
<style>
  .profile::after,
  .profile::before {
    position: absolute;
    content: "";
    width: 40%;
    aspect-ratio: 1/1;
  }
  .profile::before {
    top: 0;
    left: 0;
    z-index: 2;
    border-radius: 50%;
    border: 10px solid var(--primary-color);
    transform: translate(-50%, -50%);
  }
  .profile::after {
    top: -30px;
    right: -30px;
    z-index: -1;
    aspect-ratio: 1/2;
  }
</style>
