---
import { getCollection } from "astro:content";
let allBlogs = await getCollection("blog");
import CardBox from "./CardBox.astro";
interface Props {
  max: number;
}
const { max } = Astro.props;
allBlogs = allBlogs.slice(0, max);
---

<div class="flex flex-wrap gap-3 w-full justify-center mt-10">
  {
    allBlogs.map(({ slug, data }, i) => (
      <CardBox
        url={slug}
        title={data.title}
        img={data.image}
        description={data.description}
        tag={data.tags}
        isBlog={true}
        index={i}
      />
    ))
  }
</div>
<div class="flex justify-center w-full mt-5">
  <a href="/blog" class="btn">See more</a>
</div>

