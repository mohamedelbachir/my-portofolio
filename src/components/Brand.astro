---
import Logo from "@/assets/icons/logo.json";
export interface LogoType {
  [key: string]: string;
}
interface Props {
  name: string;
  className?: string;
  pClass?: string;
}
const { name, className, pClass = "" } = Astro.props;
const logoList = Logo as LogoType;
---

<div class={pClass}>
  <Fragment class:list={className} set:html={logoList[name]} />
</div>
