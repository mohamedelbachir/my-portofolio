---
import clsx from "clsx";
import Tilt from "react-parallax-tilt";
import Brand from "./Brand.astro";
interface Props {
  icon?: string;
  image?: ImageMetadata;
  url?: string;
  labelURL?: string;
  title: string;
  description: string;
}
const { icon, url, labelURL, image, title, description } = Astro.props;
---

<Tilt
  client:load
  className={clsx("parallax-effect", url && "!mb-14 !h-[210px]")}
  tiltReverse
  perspective={500}
  glareEnable={true}
  glareMaxOpacity={0.45}
  glareColor="var(--glare-color)"
  scale={1.02}
>
  <div class="inner-element w-1/2 h-1/2">
    <div
      class="wrapper-tilt bg-primary after:bg-[#f9f9fb] dark:after:bg-[#23262f]"
    >
      {
        icon && (
          <lord-icon
            src={icon}
            trigger="loop"
            delay="2000"
            class="w-full h-full"
          />
        )
      }
      {
        image && (
          <img
            class="shape-header w-full h-full object-cover object-center"
            {...image}
            alt={title}
          />
        )
      }
    </div>
  </div>
  <div
    class="wrapper-tilt bg-primary after:bg-[#f9f9fb] dark:after:bg-[#23262f]"
  >
    <div class="mt-[90px] text-center w-full px-1">
      <h5 class="font-heading text-primary whitespace-nowrap">
        {title}
      </h5>
      <p class="line-clamp-3 text-sm">
        <Fragment set:html={description} />
      </p>
    </div>
  </div>
  {
    url && (
      <a
        href={url}
        target="_blank"
        class="absolute -bottom-[16px] left-1/2 -translate-x-1/2 flex items-center px-3 py-1 text-white gap-2 bg-primary shape-header shape-header-sm"
      >
        <Brand name="whatsapp" pClass="size-6" />
        {labelURL}
      </a>
    )
  }
</Tilt>
