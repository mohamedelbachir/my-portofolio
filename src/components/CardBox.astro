---
import clsx from "clsx";
import { Icon } from "astro-icon/components";
interface Props {
  url: string;
  title: string;
  tag?: string[];
  languages?: string[];
  img?: {
    src: string;
    width: number;
    height: number;
    format: string;
  };
  description?: string;
  isBlog?: boolean;
  index?: number;
  demo?: string;
}
const {
  url,
  tag,
  title,
  img,
  description,
  isBlog = false,
  demo = "",
  languages,
} = Astro.props;

//const res = await fetch(`/api/views?slug=${url}`)
//const data = await res.json();
---

<div
  class={clsx(
    "card shape w-[31%] max-lg:w-[47%] max-sm:w-full shadow-md h-fit m-2 max-sm:mx-0",
    tag?.map((t) => t.replaceAll(" ", "-").toLowerCase()),
    isBlog && "isBlog"
  )}
>
  <div class={"shape card-wrapper"}>
    <a href={!isBlog ? demo : `/blog/${url}`} target={isBlog ? "" : "_blank"}>
      <div class={clsx("card-s w-full z-1 shape", !isBlog && "preview")}>
        <img
          class="shape w-full bg-primay shadow-lg image-border transition-all h-[140px] object-cover"
          width={img?.width}
          height={img?.height}
          src={img?.src}
          alt={description || ""}
          loading="lazy"
        />
      </div>
    </a>
    <div class="inline-flex gap-2 flex-wrap my-2">
      {tag?.map((t) => <span class="chip">{t}</span>)}
    </div>
    <h5 class="font-heading text-primary hover:underline line-clamp-1">
      <a href={`${isBlog ? "/blog" : "/projects"}/${url}`}>{title}</a>
    </h5>
    {
      languages && (
        <div class="flex gap-1 items-center mt-1">
          <span class="text-gray-500 dark:text-gray-400 text-sm font-heading">
            Built with :&ensp;
          </span>
          {languages?.map((l) => (
            <Icon name={l} class={"size-6 mt-[0.10rem]"} stroke-width={1} />
          ))}
        </div>
      )
    }
    {
      isBlog && (
        <>
          <div
            class="flex items-center text-gray-500 dark:text-gray-400"
            data-slug={url}
          >
            <div class="flex items-center gap-1">
              <Icon name="tabler:eye" />
              <span data-slug={url} class="view pr-1">
                -
              </span>
            </div>
            <span class="mr-4">views</span>
            <div class="flex gap-1 items-center">
              <Icon name="tabler:thumb-up" />
              <span data-slug={url} class="like">
                -
              </span>
            </div>
          </div>
        </>
      )
    }

    <p class={clsx("line-clamp-1 mt-1 mb-2")}>
      {description}
    </p>
  </div>
</div>

<style>
  .card-s {
    position: relative;
    padding: 1px;
    overflow: hidden;
    background: var(--primary-color);
  }
  .shape {
    clip-path: polygon(
      20px 0,
      100% 0,
      100% calc(100% - 20px),
      calc(100% - 20px) 100%,
      0 100%,
      0 20px
    );
  }
  .card,
  .card-wrapper {
    position: relative;
    display: block;
    z-index: 1;
    padding: 8px;
    user-select: none;
  }
  .isBlog.card-wrapper {
    padding: 10px;
  }
  .isBlog .card-s::before,
  .isBlog .card-s::after {
    content: "";
    position: absolute;
    pointer-events: none;
    right: 5px;
    width: 50%;
    aspect-ratio: 1/1;
    border: 1px solid var(--primary-color);
    z-index: 2;
    border-style: dashed;
  }
  :global(.dark) .isBlog .card-s::before,
  :global(.dark) .isBlog .card-s::after {
    border-color: rgb(77, 77, 77) !important;
  }
  .isBlog .card-s::before {
    top: 5px;
    border-left: none;
    border-bottom: none;
  }
  .isBlog .card-s::after {
    bottom: 5px;
    left: 5px;
    width: 50%;
    border-top: none;
    border-right: none;
  }
  .card {
    padding: 1px;
    overflow: hidden;
    background: var(--primary-color);
  }

  .card-wrapper::after {
    content: "";
    position: absolute;
    inset: 0;
    background-color: white;
    z-index: -1;
    height: 100%;
  }
  .card-s:hover.preview::before {
    content: "Go to the project ↗";
    cursor: pointer;
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 255, 0.616);
    display: flex;
    justify-content: center;
    align-items: center;
    color: white;
    z-index: 3;
  }
  :global(.dark) .card-s:hover.preview::before {
    background-color: rgba(85, 85, 85, 0.616);
  }
  .card-s:hover.preview > img {
    transform: scale(1.2);
  }
  :global(.dark) .card-wrapper::after {
    background-color: transparent;
  }
  :global(.dark) .card,
  :global(.dark) .card-s {
    background-color: transparent;

    background-image: linear-gradient(
      to bottom,
      color-mix(in srgb, rgba(35, 38, 47) 70%, white 30%),
      rgba(41, 41, 41, 0.678)
    );
  }
</style>
