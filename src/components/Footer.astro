---
import Logo from "@/components/Logo.astro";
---

<footer
  class="w-full shade dark:!bg-[#23262F] relative border-t border-t-primary"
>
  <div class="flex flex-wrap screen-wrapper justify-between py-5">
    <div
      class="flex flex-col w-1/3 max-sm:w-full max-sm:my-3 max-sm:items-center"
    >
      <div class="flex gap-5 items-center max-sm:gap-2">
        <Logo className="fill-black dark:fill-white w-[40px] block" />
        <span class="font-heading font-bold">BACHDEV</span>
      </div>
      <p>Open to collaborate with you!</p>
      <div class="flex gap-5"></div>
    </div>
    <div class="flex flex-col grow">
      <!-- <div
        class="self-end w-1/3 max-w-[500px] max-xl:w-1/2 max-lg:w-2/3 max-sm:px-2 absolute -top-10 px-4 shade dark:!bg-[#23262F] max-sm:w-full max-sm:left-0 clip-top"
      >
        <h3 class="text-xl py-2 max-sm:text-[1.2rem] max-sm:text-center">
          stay updated with news of my new blogs
        </h3>
        <div class="flex gap-3">
          <input
            type="email"
            name="email"
            id="email"
            placeholder="your@email.com"
            class="outline-none w-2/3 px-2 border border-primary dark:border-none"
          />
          <button class="btn max-sm:text-sm px-2 max-sm:!w-fit">
            subscribe
          </button>
        </div>
      </div> -->
      <div class="flex justify-between">
        <div class="flex flex-col w-1/2">
          <span class="text-primary font-heading">MENU</span>
          <a href="/">Home</a>
          <a href="/project">Project</a>
          <a href="/blog">Blog</a>
        </div>
        <div class="flex flex-col w-1/2">
          <span class="text-primary font-heading">My social</span>
          <a href="https://www.github.com/mohamedelbachir" target="_blank"
            >Github</a
          >
          <a
            href="https://www.linkedin.com/in/mohamed-el-bachir"
            target="_blank">Linkedin</a
          >
          <a href="https://wa.me/+237698340664" target="_blank">Whatsapp</a>
        </div>
      </div>
    </div>
  </div>
  <hr class="w-full border-t border-t-primary" />
  <h6 class="text-center py-5">
    Build with <span class="text-red-500">❤</span> By MOHAMED EL BACHIR
  </h6>
</footer>
<style>
  .shade {
    background-color: #f9f9fb;
  }
  .clip-top {
    clip-path: polygon(
      10px 0,
      100% 0,
      100% calc(100% - 10px),
      calc(100% - 10px) 100%,
      0 100%,
      0 10px
    );
    overflow: hidden;
  }
</style>
