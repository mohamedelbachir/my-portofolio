---
import Logo from "@/components/Logo.astro";
---

<footer class="w-full shade dark:!bg-[#23262F] relative">
  <div class="flex screen-wrapper justify-between py-5">
    <div class="flex flex-col w-1/3">
      <div class="flex gap-5 items-center">
        <Logo className="fill-black dark:fill-white w-[40px] block" />
        <span class="">BACHDEV</span>
      </div>
      <p>Open to collaborate with you!</p>
    </div>
    <div class="flex flex-col grow">
      <div
        class="self-end w-1/3 absolute -top-10 px-4 shade dark:!bg-[#23262F]"
      >
        <h3 class="text-xl py-2">stay updated with news of my new blogs</h3>
        <div class="flex gap-3">
          <input
            type="email"
            name="email"
            id="email"
            placeholder="your@email.com"
            class="outline-none w-2/3 px-2"
          />
          <button class="btn"> subscribe </button>
        </div>
      </div>
      <div class="flex justify-between mt-7">
        <div class="flex flex-col w-1/2">
          <span class="text-primary font-heading">MENU</span>
          <a href="/">Home</a>
          <a href="/project">Project</a>
          <a href="/blog">Blog</a>
        </div>
        <div class="flex flex-col w-1/2">
          <span class="text-primary font-heading">My social</span>
          <a href="https://www.github.com/mohamedelbachir" target="_blank"
            >Github</a
          >
          <a href="https://in" target="_blank">Linkedin</a>
          <a href="https://wa.me/698340664" target="_blank">Whatsapp</a>
        </div>
      </div>
    </div>
  </div>
  <hr class="w-full border-t-[1px] border-t-primary" />
  <h6 class="text-center py-5">
    Build with <span class="text-red-500">❤</span> By MOHAMED EL BACHIR
  </h6>
</footer>
<style>
  .shade {
    background-color: color-mix(in srgb, var(--primary-color) 30%, white 70%);
  }
</style>
