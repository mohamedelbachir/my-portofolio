---
import Logo from "@/components/Logo.astro";
import clsx from "clsx";
import ButtonTheme from "./ButtonTheme.astro";
import { Icon } from "astro-icon/components";
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.slice(1);
//data-aos="slide-down"
---
 
<header
  id="header"
  data-aw-sticky-header
  class={clsx(
    "w-full sticky z-[5] top-0 left-0 transition-all dark:text-white max-sm:fixed "
  )}
 
>
  <div
    class="flex justify-between items-center screen-wrapper py-4 max-sm:!px-2"
  >
    <a href="/" class="flex gap-3 items-center font-heading">
      <div>
        <Logo
          className="fill-black dark:fill-white w-[40px] block  max-sm:w-[35px]"
        />
      </div>
      <!-- &nearrow; -->
      <span class="block max-sm:text-sm max-lg:hidden max-sm:block"
        >BACHDEV</span
      >
    </a>
    <nav class="flex gap-5 font-heading">
      <a class={currentPath === "" ? "text-primary" : ""} href="/">Home</a>
      <a
        class={currentPath.includes("projects") ? "text-primary" : ""}
        href="/projects">Projects</a
      >
      <a class={currentPath.includes("blog") ? "text-primary" : ""} href="/blog"
        >Blog</a
      >
      <a class={currentPath === "contact" ? "text-primary" : ""} href="/contact"
        >Contact</a
      >
      <a
        class={clsx(
          "hidden min-[920px]:block max-[640px]:block",
          currentPath.includes("community") ? "text-primary" : ""
        )}
        href="/community">Community</a
      >
      <button class="btn shape-sm !hidden !w-1/2 max-sm:!block" data-hire-me>
        Hire me
      </button>
    </nav>
    <div class="flex gap-3">
      <!-- <ButtonSwitcher client:only /> -->
      <ButtonTheme />
      <button class="btn max-sm:!hidden" data-hire-me> Hire me </button>
      <button
        id="menu"
        class="hidden text-muted dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 items-center max-sm:inline-flex"
      >
        <Icon name={"tabler:menu"} class={"size-5"} />
      </button>
    </div>
  </div>
</header>

<style>
  :root {
    --light-bg: rgba(249, 249, 251, 0.9);
    --dark-bg: rgba(35, 38, 47, 0.8);
  }
  @media only screen and (max-width: 640px) {
    nav {
      --light-bg: rgba(249, 249, 251, 0.95);
      --dark-bg: rgba(35, 38, 47, 0.95);
      position: absolute;
      flex-direction: column;
      align-items: center;
      width: 95%;
      top: -390%;
      left: 50%;
      padding: 10px 0;
      transform: translateX(-50%);
      clip-path: polygon(
        10px 0,
        100% 0,
        100% calc(100% - 10px),
        calc(100% - 10px) 100%,
        0 100%,
        0 10px
      );
      background-color: var(--light-bg);
      z-index: 3;
      border: 1px solid var(--primary-color);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      transition: all 0.4s;
      opacity: 0;
    }
    nav.open {
      top: 105%;
      opacity: 1;
    }
    :global(.dark) nav {
      background-color: var(--dark-bg);
    }
    nav::before {
      position: absolute;
      top: -10px;
      left: -15px;
      content: "";
      width: 20px;
      height: 20px;
      background-color: var(--primary-color);
      transform: rotate(135deg);
      border: 1px solid var(--primary-color);
    }
    nav::after {
      position: absolute;
      bottom: -10px;
      right: -15px;
      content: "";
      width: 20px;
      height: 20px;
      background-color: var(--primary-color);
      transform: rotate(135deg);
      border: 1px solid var(--primary-color);
    }
  }

  :global(.logo) {
    width: 30px;
  }

  #header.scroll {
    border-bottom: 1px solid var(--primary-color);
    background-color: var(--light-bg);
    backdrop-filter: blur(4px);
  }

  :global(.dark) #header.scroll {
    background-color: var(--dark-bg) !important;
  }
  /*
  #23262F
