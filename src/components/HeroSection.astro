---
import Text from "@/components/Text.astro";
//import Grid from "animated-grid-lines";
import { Icon } from "astro-icon/components";
import TextSlide from "@/components/TextSlide.astro";
---

<div
  class="screen-wrapper relative text-center h-[90vh] flex items-center flex-col justify-center dark:text-white max-sm:h-screeen"
>
  <!-- <Grid
  squareSize={8}
  lineWidth={1}
  className="absolute top-0 left-0 z-[1] w-full h-full"
  gridColor="transparent"
  client:only
/> -->

  <div class="blob"></div>
  <div
    class="flex flex-col items-center justify-center h-full"
    data-aos="fade-up"
  >
    <div
      class="font-heading whitespace-nowrap font-bold text-5xl inline-flex items-center relative z-[2] leading-none h-[2em] max-xl:text-[3.5vw] max-sm:text-2xl max-sm:block max-sm:h-fit"
    >
      <span class="max-sm:text-3xl">Hi, my name is&ensp;</span><Text
        text="MOHAMED EL BACHIR"
        className=" lining-nums max-sm:text-xl  leading-normal  bg-clip-text text-transparent bg-gradient-to-b from-neutral-200 to-primary py-8 max-sm:py-4 max-sm:font-bold"
      />
    </div>
    <div
      class="inline-flex items-center gap-3 relative z-[2] my-4 font-heading max-sm:block"
    >
      <span
        class="font-bold text-2xl whitespace-nowrap leading-none block max-sm:mb-5"
        >I am
      </span>
      <TextSlide
        speed={2}
        textClassName="max-sm:text-xl max-sm:self-center max-sm:text-center whitespace-nowrap leading-2 uppercase outline-2 text-2xl font-bold bg-clip-text text-transparent bg-gradient-to-b from-neutral-200 to-indigo-600"
        data={["A Software engineer", "An AI enthousiast", "A Game developer"]}
      />
    </div>
    <div class="flex gap-3 mt-3">
      <button
        class="font-heading text-lg relative z-[2] border-primary border-[1px] px-3 flex gap-5 items-center hover:bg-primary transition-all hover:text-white max-sm:text-sm max-sm:gap-2 whitespace-nowrap"
        data-download-cv
      >
        <Icon name="tabler:download" class={"size-5"} />
        Download my CV
      </button>
      <button class="btn relative z-[2]" data-hire-me>Hire me!</button>
    </div>
    <div class="icon-scroll"></div>
  </div>
</div>

<style>
  .blob {
    position: absolute;

    opacity: 0.5;
    width: 30%;
    aspect-ratio: 1/1;
    animation: animate 10s cubic-bezier(0.68, -0.55, 0.27, 1.55) infinite
      alternate forwards;
    filter: blur(40px);
    z-index: -1;
    background: linear-gradient(
      47deg,
      rgba(255, 88, 139, 0.3) 21%,
      rgba(0, 0, 255, 0.3) 67%,
      rgba(118, 74, 166, 0.3) 81%
    );

    /*  Optional  */
    /*   box-shadow: inset 50px 50px 17px 0px #ff588b,
      inset 100px 100px 17px 0px #66319f; */
  }

  @keyframes animate {
    0% {
      translate: 100% -25%;
      border-radius: 60% 40% 30% 70% / 100% 85% 92% 74%;
    }
    50% {
      translate: 0% 13%;
      border-radius: 20% 71% 47% 70% / 81% 15% 22% 54%;
      rotate: 41deg;
      scale: 1.15;
    }
    100% {
      translate: -100% 39%;
      border-radius: 100% 75% 92% 74% / 60% 80% 30% 70%;
      rotate: -60deg;
      scale: 1.05;
    }
  }

  .icon-scroll,
  .icon-scroll:before {
    position: absolute;

    left: 50%;
  }
  .icon-scroll {
    width: 40px;
    height: 70px;
    margin-left: -20px;
    bottom: 30px;
    margin-top: -35px;
    box-shadow: inset 0 0 0 1px var(--primary-color);
    border-radius: 25px;
  }
  .icon-scroll:before {
    content: "";
    width: 8px;
    height: 8px;
    background: var(--primary-color);
    margin-left: -4px;
    top: 8px;
    border-radius: 4px;
    animation-duration: 1.5s;
    animation-iteration-count: infinite;
    animation-name: scroll;
  }
  @keyframes scroll {
    0% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(46px);
    }
  }
</style>
