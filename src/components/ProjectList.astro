---
import { getCollection } from "astro:content";
let allProjects = await getCollection("project");
import CardBox from "./CardBox.astro";
interface Props {
  max: number;
}
const { max } = Astro.props;
allProjects = allProjects
  .filter((p) => ["Jumper", "Scheduler", "Chair Rental"].includes(p.data.title))
  .slice(0, max);
---

<div
  class="filter-card-container w-full ml-5 max-lg:ml-2 max-sm:ml-0 !flex justify-center items-center mt-10"
>
  {
    allProjects.map(({ slug, data }, i) => (
      <CardBox
        url={slug}
        title={data.title}
        img={data.preview}
        description={data.description}
        tag={data.tags}
        index={i + 1}
        demo={data.demoLink}
      />
    ))
  }
</div>
<div class="flex justify-center w-full mt-5">
  <a href="/projects" class="btn">See more</a>
</div>

