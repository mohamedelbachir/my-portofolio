---
import { getCollection } from "astro:content";
let allProjects = await getCollection("project");
import CardBox from "./CardBox.astro";
interface Props {
  max: number;
}
const { max } = Astro.props;
allProjects = allProjects.slice(0, max);
---

<div class="flex flex-wrap gap-3 w-full justify-center mt-10">
  {
    allProjects.map(({ slug, data }) => (
      <CardBox
        url={slug}
        title={data.title}
        img={data.image}
        description={data.description}
        tag={data.tags}
      />
    ))
  }
</div>
<div class="flex justify-center w-full mt-5">
  <button class="btn">See more</button>
</div>

