<div class="dynamic-carousel">
  <div class="scene scene--carousel">
    <div class="carousel carousel--dynamic">
      {
        item.map((s, i) => (
          <div class="carousel__cell" style={`--bg:${s.color}`}>
            <Brand name={s.skill} className="size-5" />
          </div>
        ))
      }
    </div>
  </div>
</div>
<script is:inline data-astro-rerun>
  // dynamic carousel
  (function () {
    var demo = document.querySelector(".dynamic-carousel");
    var carousel = demo.querySelector(".carousel");
    var cells = carousel.querySelectorAll(".carousel__cell");
    var cellMax = cells.length;

    var cellCount = 3;
    var selectedIndex = 0;
    var cellWidth = carousel.offsetWidth;
    var cellHeight = carousel.offsetHeight;
    var isHorizontal = true;
    var rotateFn = isHorizontal ? "rotateY" : "rotateX";
    var radius, theta;
    var rotate = true;
    // console.log( cellWidth, cellHeight );

    carousel.addEventListener("mouseover", () => {
      rotate = false;
    });
    carousel.addEventListener("mouseout", () => {
      rotate = true;
    });
    let rotateID = 0;
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            cellCount = cellMax;
            //setTimeout(() => {
            changeCarousel();

            rotateID = setInterval(() => {
              if (rotate) {
                selectedIndex += 1;
                rotateCarousel();
              }
            }, 500);
            //}, 500);
          } else {
            cellCount = 3;
            ///setTimeout(() => {
            selectedIndex = 5;
            changeCarousel();
            window.clearInterval(rotateID);
            //}, 500);
          }
        });
      },
      {
        threshold: 0.5,
      }
    );

    function rotateCarousel() {
      var angle = theta * selectedIndex * 1;
      carousel.style.transform =
        "translateZ(" + -radius + "px) " + rotateFn + "(" + angle + "deg)";
    }

    function changeCarousel() {
      theta = 360 / cellCount;
      var cellSize = isHorizontal ? cellWidth : cellHeight;
      radius = Math.round(cellSize / 2 / Math.tan(Math.PI / cellCount));
      for (var i = 0; i < cells.length; i++) {
        var cell = cells[i];
        if (i < cellCount) {
          // visible cell
          cell.style.opacity = 1;
          var cellAngle = theta * i;
          cell.style.transform =
            rotateFn + "(" + cellAngle + "deg) translateZ(" + radius + "px)";
        } else {
          // hidden cell
          cell.style.opacity = 0;
          cell.style.transform = "none";
        }
      }

      rotateCarousel();
    }

    /* var orientationRadios = demo.querySelectorAll('input[name="orientation"]');
    (function () {
      for (var i = 0; i < orientationRadios.length; i++) {
        var radio = orientationRadios[i];
        radio.addEventListener("change", onOrientationChange);
      }
    })();

    function onOrientationChange() {
      var checkedRadio = demo.querySelector(
        'input[name="orientation"]:checked'
      );
      isHorizontal = checkedRadio.value == "horizontal";
      rotateFn = isHorizontal ? "rotateY" : "rotateX";
      changeCarousel();
    }

    // set initials
    onOrientationChange(); */

    //observe
    observer.observe(demo);
  })();
</script>
<style>
  .scene--carousel {
    width: 210px;
    height: 140px;
    margin: 40px auto;
    perspective: 1000px;
  }

  .carousel {
    width: 100%;
    height: 100%;
    position: absolute;
    transform: translateZ(-288px);
    transform-style: preserve-3d;
    transition: transform 1s;
    user-select: none;
  }

  .carousel__cell {
    position: absolute;
    width: 190px;
    height: 120px;
    left: 10px;
    top: 10px;
    line-height: 116px;
    font-size: 80px;
    font-weight: bold;
    color: white;
    text-align: center;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .carousel :global(svg) {
    height: 90px;
    width: auto;
  }

  .carousel__cell {
    background-color: var(--bg);
  }
