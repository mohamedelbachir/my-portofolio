---
import { cn } from "@/utils/cn";
interface Props{
	className?:string;
}
const {className=""} = Astro.props
---
<div
  class={cn(
    "max-w-screen relative flex flex-col items-center justify-center mt-5 rounded-xl bg-background max-sm:py-10 md:border md:p-16",
    className,
  )}
>
  <div
    class={cn(
      `absolute inset-0 z-[-1] size-full`,
      `bg-[radial-gradient(#00000055_1px,transparent_1px)] dark:bg-[radial-gradient(#ffffff22_1px,transparent_1px)]`,
      "lab-bg [background-size:16px_16px]",
    )}
  />
  <slot />
</div>