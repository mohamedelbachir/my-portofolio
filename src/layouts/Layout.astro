---
interface Props {
  title: string;
}
import Header from "@/components/Header.astro";
import Script from "@/components/Script.astro";
import { ViewTransitions } from "astro:transitions";
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Astro description" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ViewTransitions />
  </head>
  <body
    class="subpixel-antialiased min-h-screen overflow-x-hidden w-full dark:bg-[#17181C] bg-white dark:bg-grid-small-white/[0.2] bg-grid-small-black/[0.2] relative"
  >
    <Header />
    <!-- <div
        class="absolute pointer-events-none inset-0 flex items-center justify-center dark:bg-black bg-white [mask-image:radial-gradient(ellipse_at_center,transparent_20%,black)]"
      >
      </div> -->
    <slot />
    <script src="/script.js" is:inline></script>
    <style is:global>
      @tailwind base;
      @layer base {
        .btn {
          @apply btn-shape inline-flex h-10 items-center justify-center after:bg-[linear-gradient(110deg,var(--primary-color),35%,rgba(255,255,255,0.5),65%,var(--primary-color))] after:bg-[length:200%_100%] after:animate-shimmer px-6 font-medium text-white transition-colors focus:outline-none focus:ring-2 focus:ring-slate-400 focus:ring-offset-2 focus:ring-offset-slate-50 bg-primary;
        }
        .btn-no-shape {
          @apply inline-flex h-10 items-center justify-center after:bg-[linear-gradient(110deg,var(--primary-color),35%,rgba(255,255,255,0.5),65%,var(--primary-color))] after:bg-[length:200%_100%] after:animate-shimmer px-6 font-medium text-white transition-colors focus:outline-none focus:ring-2 focus:ring-slate-400 focus:ring-offset-2 focus:ring-offset-slate-50 bg-primary;
        }
      }
      @font-face {
        font-family: "TitilliumWeb";
        src: url("/fonts/TitilliumWeb-Regular.ttf");
        font-weight: normal;
        font-style: normal;
        font-display: swap;
      }
      :global(.dark) {
        color-scheme: dark;
      }

      :root {
        --primary-color: #2563eb;
      }
      * {
        box-sizing: border-box;
      }
      body {
        padding: 0;
        margin: 0;
        font-family: TitilliumWeb, sans-serif;
        scrollbar-width: thin;
      }
      .btn-shape {
        position: relative;
        clip-path: polygon(
          10px 0,
          100% 0,
          100% calc(100% - 10px),
          calc(100% - 10px) 100%,
          0 100%,
          0 10px
        );
      }
      .btn-shape::after {
        position: absolute;
        content: "";
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: -1;
      }
    </style>
  </body>
</html>
