---
import "./../styles/global.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  type?: "website" | "article";
  publishedTime?: string;
}

import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { ViewTransitions } from "astro:transitions";
import MetaData from "@/components/MetaData.astro";
import { Icon } from "astro-icon/components";
import toast, { Toaster } from "react-hot-toast";
const {
  title,
  description = "My amazing portofolio where i share thoughts and my works ",
  image = `${import.meta.env.SITE}/social-image.png`,
  canonicalUrl = import.meta.env.SITE,
  publishedTime,
  type = "website",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#2563eb" />
    <MetaData
      title={title}
      description={description}
      image={image}
      canonicalUrl={canonicalUrl}
      publishedTime={publishedTime}
      type={type}
    />
    <meta name="description" content="Astro description" />
    <!-- Vendor CSS Files -->
    <link href="/vendor/aos/aos.css" rel="stylesheet" />
    <!-- Google tag (gtag.js) -->
    <script
      type="text/partytown"
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-ZY30B7BPBH"></script>
    <script type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-ZY30B7BPBH");
    </script>
    <ViewTransitions />
  </head>
  <body
    class="overflow-x-hidden w-full dark:bg-[#17181C] bg-white dark:bg-grid-small-white/[0.15] bg-grid-small-black/[0.2] relative"
  >
    <Toaster
      toastOptions={{ className: "dark:text-white bg-light dark:bg-dark" }}
      containerStyle={{
        top: 90,
      }}
      client:load
    />
    <div id="page-content">
      <Header />
      <div
        class="fixed h-full pointer-events-none inset-0 flex items-center justify-center dark:bg-black/80 bg-white/80 [mask-image:radial-gradient(ellipse_at_center,transparent_40%,black)]"
      >
      </div>
      <div class="min-h-screen w-full overflow-x-clip">
        <slot />
      </div>
      <button
        id="back-to-top"
        class="shape fixed bottom-5 right-5 bg-primary text-white p-5 z-10 max-sm:p-4 max-sm:right-3"
      >
        <Icon name="tabler:chevron-up" />
      </button>

      <Footer />
    </div>
    <div
      id="loading-state"
      class="load dark:bg-[#17181C] bg-white dark:bg-grid-small-white/[0.2] bg-grid-small-black/[0.2] bg-fixed"
      transition:persist
    >
      <div class="spinner">
        <div></div>
        <div></div>
        <div></div>
        <div></div>
        <div></div>
        <div></div>
      </div>
      <span id="state">Loading ...</span>
    </div>
    <div id="loading">
      <div class="spinner">
        <div></div>
        <div></div>
        <div></div>
        <div></div>
        <div></div>
        <div></div>
      </div>
    </div>

    <!-- Vendor JS Files -->
    <script src="/vendor/aos/aos.js" defer></script>
    <script src="/vendor/isotope-layout/isotope.pkgd.min.js" defer></script>

    <script src="/script.js" is:inline defer></script>
    <style is:global>
      p code,ul code{
        background-color:var(--tw-prose-bullets);
      }
      .filter-chip.active {
        background-color: var(--primary-color) !important;
      }
      #page-content.hide {
        display: none;
      }
      #back-to-top {
        visibility: hidden;
        opacity: 0;
        transition: all 0.4s;
      }
      #back-to-top.active {
        visibility: visible;
        opacity: 1;
      }
      #loading-state,
      #loading {
        visibility: hidden;
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 30;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
      }
      #loading.show {
        background-color: rgba(211, 211, 211, 0.582);
      }
      :global(.dark) #loading {
        background-color: rgba(36, 36, 36, 0.582);
      }
      #loading-state.load,
      #loading.load {
        visibility: visible;
      }
      #loading-state.load #state {
        margin-top: 20px;
      }

      #loading.show {
        visibility: visible;
      }
      .spinner {
        width: 44px;
        height: 44px;
        animation: spinner-y0fdc1 2s infinite ease;
        transform-style: preserve-3d;
      }

      .spinner > div {
        background-color: rgba(0, 77, 255, 0.2);
        height: 100%;
        position: absolute;
        width: 100%;
        border: 2px solid #004dff;
      }

      .spinner div:nth-of-type(1) {
        transform: translateZ(-22px) rotateY(180deg);
      }

      .spinner div:nth-of-type(2) {
        transform: rotateY(-270deg) translateX(50%);
        transform-origin: top right;
      }

      .spinner div:nth-of-type(3) {
        transform: rotateY(270deg) translateX(-50%);
        transform-origin: center left;
      }

      .spinner div:nth-of-type(4) {
        transform: rotateX(90deg) translateY(-50%);
        transform-origin: top center;
      }

      .spinner div:nth-of-type(5) {
        transform: rotateX(-90deg) translateY(50%);
        transform-origin: bottom center;
      }

      .spinner div:nth-of-type(6) {
        transform: translateZ(22px);
      }

      @keyframes spinner-y0fdc1 {
        0% {
          transform: rotate(45deg) rotateX(-25deg) rotateY(25deg);
        }

        50% {
          transform: rotate(45deg) rotateX(-385deg) rotateY(25deg);
        }

        100% {
          transform: rotate(45deg) rotateX(-385deg) rotateY(385deg);
        }
      }

      :global(.dark) .nav {
        background-color: var(--dark-bg) !important;
      }

      .nav {
        --light-bg: rgba(249, 249, 251, 0.95);
        --dark-bg: rgba(35, 38, 47, 0.95);
        background-color: var(--light-bg);
        z-index: 3;
        border: 1px solid var(--primary-color);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
      }

      .nav::before {
        position: absolute;
        top: -10px;
        left: -15px;
        content: "";
        width: 20px;
        height: 20px;
        background-color: var(--primary-color);
        transform: rotate(135deg);
        border: 1px solid var(--primary-color);
      }
      .nav::after {
        position: absolute;
        bottom: -10px;
        right: -15px;
        content: "";
        width: 20px;
        height: 20px;
        background-color: var(--primary-color);
        transform: rotate(135deg);
        border: 1px solid var(--primary-color);
      }
    </style>

    <script is:inline>
      const elt = document.querySelector("#loading-state");
      const page = document.querySelector("#page-content");

      document.addEventListener("DOMContentLoaded", () => {
        page.classList.add("hide");
      });
      document.addEventListener("astro:page-load", () => {
        elt.classList.remove("load");
        page.classList.remove("hide");
      });
      document.addEventListener("astro:before-preparation", () => {
        document.querySelector("#loading").classList.add("show");
      });
      document.addEventListener("astro:after-preparation", () => {
        document.querySelector("#loading").classList.remove("show");
      });
      /*
      document.addEventListener("astro:before-swap", () => {
        console.table("after-preparation",elt)
        elt.classList.remove("load")
      });
      document.addEventListener("astro:after-swap", () => {
        console.table("after-swap",elt)
        elt.classList.remove("load")
      });
      document.addEventListener("readystatechange", () => {
        console.table("after-swap",elt)
        if(document.readyState==="interactive"){
          elt.classList.remove("load")
        }
        
      }); */
    </script>
  </body>
</html>
