---
import type { MarkdownHeading } from "astro";
import { clsx } from "clsx";
import TableOfContents from "@/components/libs/TOC";
export interface Props {
  headings?: MarkdownHeading[];
  isBlog?: boolean;
  slug?: string;
}
import ViewCounter from "@/components/ViewCounter";
import Likes from "@/components/Like"
const { headings = [], isBlog = false, slug } = Astro.props;
---

<div class={clsx("screen-wrapper pb-20 max-sm:!px-0")} data-aos="fade-up">
  <article class="relative flex h-full gap-5 items-start">
    <div class="w-[75%] max-lg:w-full article-content">
      <slot name="header" />
      <div
        class="relative prose max-w-none dark:prose-invert prose-headings:font-heading prose-h1:text-3xl max-sm:prose-h1:text-2xl prose-img:w-full prose-img:bg-blue-500 w-full prose-img:my-2 prose-img:min-h-20 prose-img:max-h-[300px] prose-img:object-cover max-sm:px-3 prose-headings:font-light prose-strong:font-normal prose-code:after:contain-none prose-code:before:contain-none prose-code:p-1 prose-code:rounded-md prose-td:flex prose-td:justify-center"
      >
        <slot name="content" />
        <slot name="preview" />
        {
          isBlog && (
            <div
              id="viewbar"
              class="sticky bottom-3 max-sm:-translate-x-[40%] left-1/2 max-lg:-translate-x-1/2 lg:translate-x-[-120%] lg:left-[50%] size-10 bg-red-500"
            >
              <div class="flex items-center w-full h-full px-4">
                <ViewCounter client:only slug={slug} />
                <Likes client:only slug={slug}/>
              </div>
            </div>
          )
        }
        <div class="mt-10">
          <slot name="comment" />
        </div>
        
      </div>
    </div>

    <TableOfContents headers={headings} />

    <!--
      {headings && headings.length > 0 && (
        <div class="sticky w-[23%] top-[5.5rem] nav shape p-2 max-lg:hidden">
          <span class="font-heading my-0 font-bold whitespace-nowrap !text-lg">
            Table of content
          </span>
          <TOC headings={headings} />
        </div>
      )}
      --
    />
    
  </article>
  <style>
    
  </style>
</div>
-->
  </article>
</div>
<style>
  #viewbar {
    height: 40px;
    width:fit-content;
    pointer-events: auto;
    z-index: 20;
    background: linear-gradient(
      180deg,
      rgb(249, 249, 251) 0%,
      rgba(249, 249, 251, 0.88) 100%
    );
    border-radius: 9999px;
    border: 1px solid var(--primary-color);
  }

  :global(.dark) #viewbar {
    background: linear-gradient(
      180deg,
      #13151a 0%,
      rgba(19, 21, 26, 0.88) 100%
    );
    border: 1px solid #343841;
    box-shadow:
      0px 0px 0px 0px rgba(19, 21, 26, 0.3),
      0px 1px 2px 0px rgba(19, 21, 26, 0.29),
      0px 4px 4px 0px rgba(19, 21, 26, 0.26),
      0px 10px 6px 0px rgba(19, 21, 26, 0.15),
      0px 17px 7px 0px rgba(19, 21, 26, 0.04),
      0px 26px 7px 0px rgba(19, 21, 26, 0.01);
  }
</style>
