---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="NotFound">
  <section class="flex items-center h-full p-16 max-sm:px-0" data-aos="fade-up">
    <div
      class="container flex flex-col items-center justify-center px-5 mx-auto my-8 "
    >
      <div class="max-w-md text-center">
        <h2 class="mb-8 font-bold text-9xl">
          <span class="sr-only">Error</span>
          <span
            class="text-primary  animate__animated animate__bounce animate__slower animate__repeat-2"
            data-aos="slide-down" data-aos-delay="100">404</span
          >
        </h2>
        <p class="text-3xl font-semibold md:text-3xl">
          Sorry, we couldn't find this page.
        </p>
        <p class="mt-4 mb-8 text-lg text-muted dark:text-slate-400">
          But dont worry, you can find plenty of other things on my homepage.
        </p>
        <a rel="noopener noreferrer" href={"/"} class="btn ml-4"
          >Back to homepage</a
        >
      </div>
    </div>
  </section>
</Layout>
