---
import { Icon } from "astro-icon/components";
import MarkdownPostLayout from "../../../layouts/LayoutMarkdown.astro";
import Layout from "../../../layouts/Layout.astro";
import { getEntryBySlug } from "astro:content";
import ImageAuthor from "@/assets/images/me.jpeg";
import { Image } from "astro:assets";
const { slug } = Astro.params;
const blog = await getEntryBySlug("blog", slug as string);
if (!blog) {
  return Astro.redirect("/404");
}

const { Content, headings, remarkPluginFrontmatter } = await blog.render();
const date = new Intl.DateTimeFormat("en-GB", {
  dateStyle: "full",
}).format(blog.data.pubDate);
---

<Layout
  title={blog.data.title}
  description={blog.data.description}
  canonicalUrl={`${import.meta.env.SITE}/blog/${slug}/`}
  publishedTime={blog.data.pubDate.toISOString()}
  image={`${import.meta.env.SITE}/blog/${slug}/og`}
  type="article"
>
  <MarkdownPostLayout headings={headings} isBlog={true}>
    <Fragment slot="header">
      <div
        class="bg-[var(--light-bg)] dark:bg-[var(--dark-bg)] py-2 border-b border-b-primary mb-5 prose-figure:w-full dark:border-none max-sm:pt-20"
      >
        <div class="px-2">
          <h1 class="font-heading text-2xl my-2">
            {blog.data.title}
          </h1>
          <p class="text-gray-400">{blog.data.description}</p>
          <div class="flex gap-2 flex-wrap">
            {blog.data.tags.map((t: string) => <span class="chip">{t}</span>)}
          </div>
        </div>
        <img
          class="h-80 w-full object-cover my-2 border-y border-primary max-sm:h-48"
          {...blog.data.preview}
          alt={"BLOG POST COVER"}
        />
        <div>
          <div
            class="flex px-2 justify-between items-center max-[500px]:flex-col"
          >
            <div class="author flex gap-2 items-center max-[500px]:w-full">
              <Image
                src={ImageAuthor}
                alt={"mohamed el achir"}
                class={"size-14 object-cover rounded-full border-2 border-primary"}
              />
              <div class="flex justify-between">
                <div class="flex flex-col text-sm">
                  <a class="text-primary font-heading hover:underline" href="/"
                    >MOHAMED EL BACHIR</a
                  >
                  <span class="text-gray-400"
                    >{date}&ensp;<span class="text-lg font-bold leading-none"
                      >&middot;</span
                    >&ensp;{remarkPluginFrontmatter.minutesRead}</span
                  >
                </div>
              </div>
            </div>
            <div
              class="social flex gap-2 max-[500px]:w-full max-[500px]:justify-end"
            >
              <button
                data-aw-social-share="facebook"
                data-aw-url=`{${import.meta.env.SITE}/blog/${slug}/}`
                data-aw-text={blog.data.description}
                class="size-10 shape-sm bg-blue-500 flex justify-center items-center"
              >
                <Icon name="tabler:brand-facebook" class="size-6 text-white" />
              </button>
              <button
                class="size-10 shape-sm bg-blue-500 flex justify-center items-center"
                data-aw-social-share="twitter"
                data-aw-url=`{${import.meta.env.SITE}/blog/${slug}/}`
                data-aw-text={blog.data.description}
              >
                <Icon
                  name="tabler:brand-twitter-filled"
                  class="size-5 text-white"
                />
              </button>
              <button
                data-aw-social-share="linkedin"
                data-aw-url=`{${import.meta.env.SITE}/blog/${slug}/}`
                data-aw-text={blog.data.description}
                class="size-10 shape-sm bg-blue-500 flex justify-center items-center"
              >
                <Icon name="tabler:brand-linkedin" class="size-5 text-white" />
              </button>
              <button
                data-aw-social-share="whatsapp"
                data-aw-url=`{${import.meta.env.SITE}/blog/${slug}/}`
                data-aw-text={blog.data.description}
                class="size-10 shape-sm bg-blue-500 flex justify-center items-center"
              >
                <Icon name="tabler:brand-whatsapp" class="size-5 text-white" />
              </button>
            </div>
          </div>
        </div>
      </div>
    </Fragment>
    <Fragment slot="content">
      <Content />
    </Fragment>
  </MarkdownPostLayout>
</Layout>
<style>
  .no-shape {
    clip-path: var(--bottom-shape);
  }
</style