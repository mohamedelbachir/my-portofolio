---
import { getCollection } from "astro:content";
const allProjects = await getCollection("blog");
import CardBox from "@/components/CardBox.astro";
import Heading from "@/components/Heading.astro";
import Layout from "./../../layouts/Layout.astro";
---

<Layout title="Blog">
  <section id="education" class="screen-wrapper max-lg:py-10 max-sm:py-16" data-aos="fade-up">
    <Heading> All blog posts </Heading>
    <p class="text-center">
      A collection of useful articles i have written. You can select a specific
      post tag to filter posts for that topic
    </p>

    <div class="flex flex-wrap gap-3 w-full justify-center mt-10">
      {
        allProjects.map(({ slug, data }) => (
          <CardBox
            url={slug}
            title={data.title}
            img={data.preview}
            description={data.description}
            tag={data.tags}
            isBlog
          />
        ))
      }
    </div>
  </section>
</Layout>
