---
import { getCollection } from "astro:content";
const allProjects = await getCollection("project");
import CardBox from "@/components/CardBox.astro";
import Heading from "@/components/Heading.astro";
import Layout from "./../../layouts/Layout.astro";
---

<Layout title="Blog">
  <section id="education" class="screen-wrapper my-10">
    <Heading> MY LATEST BLOG </Heading>
    <p class="text-center">Here where i have fun to share my thought .</p>
    <div class="flex flex-wrap gap-3 w-full justify-center mt-10">
      {
        allProjects.map(({ slug, data }) => (
          <CardBox
            url={slug}
            title={data.title}
            img={data.image}
            description={data.description}
            tag={data.tags}
            isBlog
          />
        ))
      }
    </div>
  </section>
</Layout>
