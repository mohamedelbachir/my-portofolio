---
import Layout from "@/layouts/Layout.astro";
import Heading from "@/components/Heading.astro";
import Card from "@/components/Card.astro";
import LogoFront from "@/assets/images/community/front.jpeg";
import LogoCPP from "@/assets/images/community/cpp.jpeg";
import LogoGeek from "@/assets/images/community/geek.jpeg";
---

<Layout
  title="community"
  description="List of awesome community where we share useful ressources and help each other"
  image=`${import.meta.env.SITE}/social-media-networking.png`
>
  <section
    id="education"
    class="screen-wrapper max-lg:py-10 max-sm:py-16 mb-24"
    data-aos="fade-up"
  >
    <Heading> Community </Heading>
    <p class="text-center">
      List of awesome community where we share useful ressources and help each
      other
    </p>
    <div
      class="flex flex-wrap w-full mt-14 justify-center items-center gap-3"
      data-aos="fade-up"
    >
      <Card
        title="Frontend Dev"
        description="<span class='text-gray-400'>community</span><br/><span class='text-primary font-heading'>179+</span> members<br/> All about frontend development"
        image={LogoFront}
        url="https://chat.whatsapp.com/EaPCoPd5kjs3FtgvexLd6G"
        labelURL="Join now"
      />
      <Card
        title="C/C++"
        description="<span class='text-gray-400'>community</span><br/><span class='text-primary font-heading'>102+</span> members <br/> All about C/C++ programming"
        image={LogoCPP}
        url="https://chat.whatsapp.com/DrGbzTck8wM3GeIU8EOpab"
        labelURL="Join now"
      />
      <Card
        title="Universe Of Geek"
        description="<span class='text-gray-400'>group</span><br/><span class='text-primary font-heading'>30+</span> members <br/> All about Tech and IT"
        image={LogoGeek}
        url="https://chat.whatsapp.com/B9hGVn5ZJeT3xgPjOX3Aob"
        labelURL="Join now"
      />
    </div>
  </section>
</Layout>
