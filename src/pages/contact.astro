---
import Heading from "@/components/Heading.astro";
import Layout from "@/layouts/Layout.astro";
import ContactFrom from "@/components/libs/Contact.tsx";
export const prerender = false;
---

<Layout title="contact" description="Feel fee to leave your message here">
  <section data-aos="fade-up">
    <div class="pb-16 pt-5 max-sm:py-16 px-4 mx-auto max-w-screen-md">
      <Heading> Contact </Heading>
      <p class="mb-8 lg:mb-10 font-light text-center sm:text-xl">
        Send me a message
      </p>
      <ContactFrom client:load />
    </div>
  </section>
</Layout>
