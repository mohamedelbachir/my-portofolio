---
import Layout from "@/layouts/Layout.astro";
import HeroSection from "@/components/HeroSection.astro";
import About from "@/components/About.astro";
import Steps from "@/components/Steps.astro";
import Heading from "@/components/Heading.astro";
import Skills from "@/components/Skills.astro";
import ProjectList from "@/components/ProjectList.astro";
import BlogList from "@/components/BlogList.astro";
import Card from "@/components/Card.astro";
import userData from "@/data/userData.json";

const { workExperience, education, skills, services } = userData;

// Format work experience for Steps component
const formattedWorkExperience = workExperience.map((job) => ({
  title: job.title,
  at: `${job.company}, ${job.location}`,
  dateRange: job.dateRange,
  description: job.description,
  icon: job.icon,
  classes: {
    title: "dark:text-white font-heading",
    at: "text-primary text-base font-heading",
    date: "dark:text-white",
    icon: "dark:text-white",
    description: "dark:text-slate-200 text-lg",
  },
}));

// Format education for Steps component
const formattedEducation = education.map((edu) => ({
  title: edu.degree,
  at: edu.institution,
  dateRange: edu.dateRange,
  icon: edu.icon,
  classes: {
    title: "dark:text-white font-heading",
    at: "text-primary text-base font-heading",
    date: "dark:text-white",
    icon: "dark:text-white",
  },
}));

// Format skills for Skills component
const formattedSkills = skills.map((skill) => ({
  skill: skill.name,
  color: skill.color,
}));
---

<Layout title="Home">
  <HeroSection />
  <About />
  
  <section id="work" class="screen-wrapper my-14" data-aos="fade-up">
    <Heading>Work experience</Heading>
    <div data-aos="fade-up" data-aos-delay="200">
      <Steps items={formattedWorkExperience} />
    </div>
  </section>

  <section id="education" class="screen-wrapper my-10" data-aos="fade-up">
    <Heading>Education</Heading>
    <div data-aos="fade-up" data-aos-delay="200">
      <Steps items={formattedEducation} />
    </div>
  </section>

  <section id="education" class="screen-wrapper my-10" data-aos="fade-up">
    <Heading>SKILLS</Heading>
    <p class="text-center">
      Discover the proficiencies that allow me to bring imagination to life.
    </p>
    <div data-aos="fade-up" data-aos-delay="200">
      <Skills item={formattedSkills} />
    </div>
  </section>

  <section id="education" class="screen-wrapper my-10" data-aos="fade-up">
    <Heading>MY PROJECTS</Heading>
    <p class="text-center">
      Projects that i made with passion and ambition to learn.
    </p>
    <div data-aos="fade-up"><ProjectList max={3} /></div>
  </section>

  <section id="education" class="screen-wrapper mt-10 mb-20" data-aos="fade-up">
    <Heading>MY LATEST BLOG</Heading>
    <p class="text-center">Here is where i have fun to share my thought .</p>
    <div data-aos="fade-up"><BlogList max={3} /></div>
  </section>
</Layout>