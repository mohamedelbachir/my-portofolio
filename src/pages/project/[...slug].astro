---
import MarkdownPostLayout from "../../layouts/LayoutMarkdown.astro";
import Layout from "../../layouts/Layout.astro";
import { getEntryBySlug } from "astro:content";

const { slug } = Astro.params;
const project = await getEntryBySlug("project", slug as string);
if (!project) {
  return Astro.redirect("/404");
}

const { Content, headings } = await project.render();
---

<Layout title={project.data.title}>
  <MarkdownPostLayout headings={headings}>
    <Fragment slot="preview">
      <button class="btn"
        ><a href={project.data.demoLink} target="_blank">Go to the project</a
        ></button
      >
    </Fragment>
    <Fragment slot="content">
      <Content />
    </Fragment>
  </MarkdownPostLayout>
</Layout>
