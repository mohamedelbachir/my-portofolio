---
import MarkdownPostLayout from "../../layouts/LayoutMarkdown.astro";
import Layout from "../../layouts/Layout.astro";
import { getEntryBySlug } from "astro:content";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import ImageAuthor from "@/assets/images/me.jpeg";
import Language from "@/components/Language.astro"
const { slug } = Astro.params;
const project = await getEntryBySlug("project", slug as string);
if (!project) {
  return Astro.redirect("/404");
}

const { Content, headings } = await project.render();
---

<Layout title={project.data.title} description="List of project that i made">
  <MarkdownPostLayout headings={headings}>
    <Fragment slot="header">
      <div
        class="relative bg-[var(--light-bg)] dark:bg-[var(--dark-bg)] pb-2 border-b border-b-primary mb-5 prose-figure:w-full dark:border-none max-sm:pt-20 mt-3 max-sm:mt-0"
      >
        <div
          class="relative h-80 w-full my-2 border-y border-primary max-sm:h-48"
        >
          <img
            class="w-full h-full object-cover"
            alt={"PROJECT POST COVER"}
            {...project.data.preview}
          />
          <div
            class="absolute z-[2] inset-0 flex items-center justify-center bg-black/85 px-5"
          >
            <div class="text-center">
              <a
                href="/projects"
                class="my-1 text-primary inline-flex items-center"
                ><Icon name="tabler:chevron-left" /><span>All Projects</span></a
              >
              <h1 class="font-heading text-2xl text-white line-clamp-2">
                {project.data.title}
              </h1>
              <p class="text-gray-400 max-sm:text-sm line-clamp-2 my-1">
                {project.data.description}
              </p>
              <div class="flex gap-2 flex-wrap w-full justify-center mt-3">
                {
                  project.data.tags.map((t: string) => (
                    <span class="chip">{t}</span>
                  ))
                }
              </div>
            </div>
          </div>
        </div>

        <div>
          <div
            class="flex px-2 justify-between items-center max-[500px]:flex-col max-[500px]:items-end"
          >
            <div class="author flex gap-2 items-center max-[500px]:w-full">
              <Image
                src={ImageAuthor}
                alt={"mohamed el achir"}
                class={"size-14 object-cover rounded-full border-2 border-primary"}
              />
              <div class="flex justify-between">
                <div class="flex flex-col text-sm">
                  <a class="text-primary font-heading hover:underline" href="/"
                    >MOHAMED EL BACHIR</a
                  >
                  <span class="text-gray-400">author</span>
                </div>
               
              </div>
            </div> 
            <Language datas={project.data.languages}/>
          </div>
        </div>
      </div>
    </Fragment>
    <Fragment slot="preview">
      <button class="btn"
        ><a
          href={project.data.demoLink}
          class="no-underline text-white"
          target="_blank">Go to the project</a
        ></button
      >
    </Fragment>
    <Fragment slot="content">
      <Content />
    </Fragment>
  </MarkdownPostLayout>
</Layout>
