---
import { getCollection } from "astro:content";
const allProjects = await getCollection("project");
import CardBox from "@/components/CardBox.astro";
import Heading from "@/components/Heading.astro";
import Layout from "./../../layouts/Layout.astro";
import clsx from "clsx";
const uniqueTags = [
  "All",
  ...new Set(
    allProjects
      .map((post) => post.data.tags)
      .flat()
      .map((t) => t.toLowerCase())
  ),
];
---

<Layout title="project">
  <section
    id="education"
    class="screen-wrapper max-lg:py-10 max-sm:py-16 mb-24"
    data-aos="fade-up"
  >
    <Heading> MY PROJECTS </Heading>
    <p class="text-center">
      Projects that i made with passion and ambition to learn.
    </p>
    <div
      class="filter-container flex w-full justify-center gap-2 mt-4 flex-wrap"
    >
      {
        uniqueTags?.map((t) => (
          <a
            href={`#${t}`}
            data-filter={t === "All" ? "*" : "." + t.replaceAll(" ", "-")}
            class={clsx(
              "filter-chip chip !text-lg max-sm:!text-sm !bg-slate-400",
              {
                active: t == "All",
              }
            )}
          >
            {t}
          </a>
        ))
      }
    </div>

    <div
      class="filter-card-container w-full ml-5 max-lg:ml-2 max-sm:ml-0 !flex justify-center items-center mt-10"
    >
      {
        allProjects.map(({ slug, data }) => (
          <CardBox
            url={slug}
            title={data.title}
            img={data.preview}
            description={data.description}
            tag={data.tags}
            demo={data.demoLink}
          />
        ))
      }
    </div>
  </section>
</Layout>
